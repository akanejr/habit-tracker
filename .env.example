# ─────────────────────────────────────────────────────────────────────────────
# Habit Tracker — environment variables
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# On Vercel, add the same variables in:
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# NEVER commit `.env.local` or any file containing real secret values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Project: Habit-Tracker (ref: retkelaxegvlkuzhgosz, region: eu-west-1)
# Find these in: Supabase Dashboard → Project Settings → API
#
# The project URL is not secret — it is embedded in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url-here

# The publishable (anon) key is safe to expose in the browser by design.
# It is always enforced by Row Level Security on the database.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# No service-role or secret key is needed for this foundation. Never put one
# in a NEXT_PUBLIC_ variable, client code, or source control.
